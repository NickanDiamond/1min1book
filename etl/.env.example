# Copy to etl/.env and fill in — never commit the real file.

# This project's own database (destination). Local Postgres or a hosted
# free-tier instance both work the same way from here.
DATABASE_URL=postgresql://user:password@localhost:5432/onemin1book_graph

# 1Min1Book source (read-only). Fill in once we confirm how the sheet is
# authenticated — service account JSON path + spreadsheet ID.
ONEMIN1BOOK_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# transform.py -- theme/genre extraction. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# Pick a model your key has access to (console.anthropic.com/settings/models).
# transform.py makes ~663 sequential calls -- a fast/cheap model is the right
# choice here, not the most capable one.
ETL_MODEL=
